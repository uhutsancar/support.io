{
  "name": "supportchat-workspace",
  "version": "1.0.0",
  "description": "SaaS Customer Support Chat System",
  "private": true,
  "scripts": {
    "install:all": "cd backend && npm install && cd ../admin-panel && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:admin": "cd admin-panel && npm run dev",
    "start:backend": "cd backend && npm start",
    "build:backend": "cd backend && npm run build",
    "build:admin": "cd admin-panel && npm run build",
    "typecheck": "cd backend && npm run typecheck && cd ../admin-panel && npm run typecheck",
    "test:backend": "cd backend && npm test"
  },
  "keywords": [
    "support",
    "chat",
    "saas",
    "customer-service"
  ],
