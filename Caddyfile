:80

# The backend mounts its routes under /api itself (app.use('/api/auth', ...)),
# so the prefix must be forwarded intact. `handle_path` would strip it and turn
# /api/auth/me into /auth/me, which the backend answers 404 for.
handle /api/* {
    reverse_proxy backend:3000
}

# Socket.IO negotiates over /socket.io before upgrading; without this the widget
# and admin realtime connections fall through to the SPA handler below.
handle /socket.io/* {
    reverse_proxy backend:3000
}

# The embeddable widget and the backend's own static assets.
# /widget* olarak yazilir cunku sabitlenmis surum yolu (/widget/v3/widget.js)
# ve /widget/widget.js de ayni dosyaya duser; yalnizca /widget.js yazilinca
# bunlar SPA handler'ina dusup HTML donuyordu. SPA'da kok /widget rotasi yok.
handle /widget* {
    reverse_proxy backend:3000
}

handle /health {
    reverse_proxy backend:3000
}

# Widget entegrasyon test sayfasi backend'in statik dosyalari arasindadir.
# Bu blok olmadan /demo asagidaki SPA handler'ina duser ve Vite admin
# panelinin index.html'ini dondururdu.
handle /demo* {
    reverse_proxy backend:3000
}

handle {
    reverse_proxy admin:5173
}

# Basic security headers
header {
    Strict-Transport-Security "max-age=31536000;"
}
