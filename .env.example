# Root .env for docker compose. Copy to .env; it is not committed.
#
# Leave the next two lines commented on a machine without an NVIDIA GPU: the
# app then starts exactly as before, with AI off.
# COMPOSE_PROFILES=ai
# AI_ENABLED=true

# Shared secret between the backend and the model server: openssl rand -hex 32
AI_API_KEY=
# Printed by `npm run ai:download`: asure-12b-<first 7 characters of the revision>
AI_MODEL=
# The commit of Trendyol/Trendyol-LLM-Asure-12B to download; a full SHA, never "main".
AI_MODEL_REVISION=
# Widget answers by the assistant, separately from the agents' copilot.
AI_AUTO_REPLY_ENABLED=false
