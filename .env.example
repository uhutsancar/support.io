# Root .env for docker compose (development). Copy to .env; it is not committed.
#
# Host ports, for a workstation where the defaults are taken:
# POSTGRES_PORT=5433
# BACKEND_PORT=5050
# ADMIN_PORT=5173
# PROXY_PORT=80
#
# Secrets and the Gemini key belong in backend/.env (see backend/.env.example),
# which the backend container reads; it is not committed either.
