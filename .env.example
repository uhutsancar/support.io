# Root .env for docker compose (development). Copy to .env; it is not committed.
#
# Host ports, for a workstation where the defaults are taken:
# POSTGRES_PORT=5433
# BACKEND_PORT=5050
# ADMIN_PORT=5173
# PROXY_PORT=80
#
# Secrets and the Gemini key belong in backend/.env (see backend/.env.example),
# which the backend container reads; it is not committed either.
#
# Paddle sandbox (optional). Compose passes these to the backend; without
# them a development webhook secret and price ids are used so the e2e suite
# can sign webhooks (docker-compose.yml). Checkout opens only with
# BILLING_ENABLED=true and a sandbox client token.
# BILLING_ENABLED=false
# PADDLE_ENV=sandbox
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_CLIENT_TOKEN=
# PADDLE_PRICE_PRO=
# PADDLE_PRICE_PRO_YEARLY=
# PADDLE_PRICE_ENTERPRISE=
# PADDLE_PRICE_ENTERPRISE_YEARLY=
