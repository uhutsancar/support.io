# `npm run dev` sirasinda yuklenir. Yerel backend.
# Bu dosya depoya girer; makineye ozel deger icin .env.local kullanin.
VITE_API_URL=http://localhost:5000

# Pazarlama sitesinin kendi sohbet balonu. Demo tohumundaki sitenin anahtari;
# mesajlar owner@demo.support.io panelinde gorunur. Bos birakilirsa balon
# yuklenmez. Uretimde gercek sitenin anahtari .env.production'a yazilir.
VITE_SUPPORT_SITE_KEY=demo-site-key-0000-1111-2222
