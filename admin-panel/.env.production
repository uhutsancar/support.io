# `npm run build` sirasinda yuklenir.
#
# Panel, API ve widget uretimde tek origin'den sunulur (Caddy -> backend), bu
# yuzden API adresi BOS kalir ve istekler sayfanin kendi origin'ine gider.
# Buraya sabit bir sunucu adresi yazmak, adres degistiginde paneli sessizce
# eski makineye baglar; CI bu dosyada IP adresi gorurse derlemeyi durdurur.
VITE_API_URL=

# Pazarlama sitesinin kendi sohbet balonu. Bos birakilirsa balon yuklenmez;
# uretimde gercek sitenin anahtari derleme ortamindan verilir.
VITE_SUPPORT_SITE_KEY=
