# Editor defaults, so a file's indentation does not depend on who opened it.
#
# Five files in admin-panel/src/pages were indented with four spaces and the
# rest with two, because nothing in the repository said which to use. This is
# the smallest of the three layers that now do: the editor reads this, Prettier
# enforces it on save and in CI, and ESLint checks what Prettier cannot.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
# Markdown uses trailing spaces for hard line breaks.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
