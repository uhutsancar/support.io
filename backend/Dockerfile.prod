# The production image: the API, the widget runtime and the built panel and
# marketing site, served from one origin (plan §13.3).
#
# Every stage starts from the same Node image, named once below and pinned by
# digest so a rebuild cannot silently change the runtime. Dependabot
# (.github/dependabot.yml) proposes the new digest when the upstream image is
# rebuilt; keep backend/Dockerfile and admin-panel/Dockerfile on the same one.
FROM node:22.23.3-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS node-base

FROM node-base AS admin-build
WORKDIR /build/admin-panel
COPY admin-panel/package.json admin-panel/package-lock.json ./
RUN npm ci
COPY admin-panel/ ./
# The panel talks to its own origin, so the API address stays empty.
ARG VITE_API_URL=""
# The marketing site's own chat bubble (a site key, which is not a secret).
ARG VITE_SUPPORT_SITE_KEY=""
# Shown in install snippets; empty means "the page's own origin".
ARG VITE_PUBLIC_APP_ORIGIN=""
# The commit this image is built from: error reports name it (OBS-01).
ARG APP_RELEASE=""
# The public status page, linked in the site's footer once it exists (OBS-06).
ARG VITE_STATUS_PAGE_URL=""
# The addresses the site shows (MKT-01); empty keeps the defaults in lib/contact.ts.
ARG VITE_SUPPORT_EMAIL=""
ARG VITE_SECURITY_EMAIL=""
ENV VITE_API_URL=${VITE_API_URL} \
    VITE_SUPPORT_EMAIL=${VITE_SUPPORT_EMAIL} \
    VITE_SECURITY_EMAIL=${VITE_SECURITY_EMAIL} \
    VITE_SUPPORT_SITE_KEY=${VITE_SUPPORT_SITE_KEY} \
    VITE_PUBLIC_APP_ORIGIN=${VITE_PUBLIC_APP_ORIGIN} \
    VITE_APP_RELEASE=${APP_RELEASE} \
    VITE_STATUS_PAGE_URL=${VITE_STATUS_PAGE_URL}
RUN npm run build

FROM node-base AS backend-build
WORKDIR /build/backend
COPY backend/package.json backend/package-lock.json ./
RUN npm ci
COPY backend/ ./
# Compiles src/ to dist/ (migrations included) and the widget to public/widget.js.
RUN npm run build

FROM node-base AS backend-deps
WORKDIR /build/backend
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

# The runtime is plain Alpine (the release the Node image is built on) with
# only the node binary copied in: no npm, npx, corepack or yarn. Nothing at
# runtime needs a package manager, and their bundled dependencies were the
# only findings the image scan reported on the Node image; deleting them in a
# later layer would hide them without making the image any smaller. Support
# commands run as `node dist/cli/<name>.js`. tini is PID 1 so SIGTERM reaches
# node and exited children are reaped.
FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS runtime
RUN apk upgrade --no-cache \
 && apk add --no-cache libstdc++ libgcc tini \
 && addgroup -g 1000 node \
 && adduser -u 1000 -G node -s /bin/sh -D node
COPY --from=node-base /usr/local/bin/node /usr/local/bin/node
ARG APP_RELEASE=""
ENV NODE_ENV=production \
    APP_RELEASE=${APP_RELEASE}
WORKDIR /app/backend
COPY --chown=node:node backend/package.json ./
COPY --from=backend-build --chown=node:node /build/backend/dist ./dist
COPY --from=backend-build --chown=node:node /build/backend/public ./public
COPY --from=backend-deps --chown=node:node /build/backend/node_modules ./node_modules
COPY --from=admin-build --chown=node:node /build/admin-panel/dist /app/admin-panel/dist
# Owned by node so a named volume mounted here starts writable
# (UPLOAD_STORAGE=local only).
RUN mkdir -p /app/backend/uploads && chown node:node /app/backend/uploads
USER node
EXPOSE 3000
# The same probe docker-compose.prod.yml uses, so the image is checked the
# same way when it runs without Compose.
HEALTHCHECK --interval=15s --timeout=10s --start-period=30s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:3000/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/server.js"]
