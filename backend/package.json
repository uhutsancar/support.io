{
  "name": "supportchat-backend",
  "version": "1.0.0",
  "description": "SaaS Customer Support Backend API",
  "main": "dist/server.js",
  "scripts": {
    "server": "npm run build:widget && nodemon",
    "dev": "npm run build:widget && nodemon",
    "start": "node dist/server.js",
    "build": "npm run build:widget && tsc -p tsconfig.build.json && tsx scripts/copy-assets.ts",
    "build:widget": "tsc -p tsconfig.widget.json && tsx scripts/minify-widget.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.widget.json",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:schema": "tsx scripts/build-schema.ts",
    "db:seed": "tsx src/db/seed.ts",
    "plan:set": "tsx src/cli/updatePlan.ts",
    "plan:set:prod": "node dist/cli/updatePlan.js",
    "org:list": "tsx src/cli/listOrganizations.ts",
    "org:list:prod": "node dist/cli/listOrganizations.js",
    "org:stats": "tsx src/cli/orgStats.ts",
    "org:stats:prod": "node dist/cli/orgStats.js",
    "referrals:due": "tsx src/cli/referralsDue.ts",
    "referrals:due:prod": "node dist/cli/referralsDue.js",
    "site:disable": "tsx src/cli/disableSite.ts",
    "site:disable:prod": "node dist/cli/disableSite.js",
    "secrets:rotate": "tsx src/cli/rotateSecrets.ts",
    "secrets:rotate:prod": "node dist/cli/rotateSecrets.js",
    "assistant:kill": "tsx src/cli/assistantKill.ts",
    "assistant:kill:prod": "node dist/cli/assistantKill.js",
    "assistant:eval": "tsx scripts/assistant-eval.ts",
    "push:keys": "tsx scripts/vapid-keys.ts",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:compose": "tsx scripts/test-compose.ts",
    "reconnect-storm": "tsx scripts/test-compose.ts scripts/reconnect-storm.ts",
    "loadtest": "tsx scripts/test-compose.ts scripts/loadtest.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore",
    "check": "npm run typecheck && npm run lint"
  },
  "keywords": [
    "support",
    "chat",
    "saas",
    "websocket"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.400.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@paddle/paddle-node-sdk": "3.10.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.0",
    "pino": "9.14.0",
    "redis": "^6.2.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.6.1",
    "unpdf": "1.8.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/web-push": "3.6.4",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.9.8",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
