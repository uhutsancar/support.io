{
  "name": "supportchat-backend",
  "version": "1.0.0",
  "description": "SaaS Customer Support Backend API",
  "main": "dist/server.js",
  "scripts": {
    "server": "npm run build:widget && nodemon",
    "dev": "npm run build:widget && nodemon",
    "start": "node dist/server.js",
    "build": "npm run build:widget && tsc -p tsconfig.build.json && tsx scripts/copy-assets.ts",
    "build:widget": "tsc -p tsconfig.widget.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.widget.json",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "demo:orders": "tsx scripts/demoOrderService.ts",
    "ai:bench": "tsx scripts/aiBench.ts",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:compose": "tsx scripts/test-compose.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint"
  },
  "keywords": [
    "support",
    "chat",
    "saas",
    "websocket"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.400.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/cookie-parser": "^1.4.10",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "multer-s3": "^3.0.1",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.9.8",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
