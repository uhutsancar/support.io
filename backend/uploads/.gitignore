# Uploaded files are not source.
#
# With S3 configured this directory stays empty. Without it — the local
# development default — chat attachments land in files/ and site logos in
# logos/ (see src/middleware/upload.ts). Neither is source, and both hold
# whatever a stranger uploaded, so nothing below is ever committed.
files/*
!files/.gitkeep
logos/*
!logos/.gitkeep

# Private chat attachments (plan v10 SEC-08): org/<org>/site/<site>/<file>.
org/
