# backend/.env örneği — gerçek değerleri .env dosyasına yazın (.env git'e girmez)

PORT=5000
NODE_ENV=development
JWT_SECRET=<rastgele-uzun-secret>

WIDGET_URL=http://localhost:3001
ADMIN_URL=http://localhost:3004

# --- AWS S3 (logo + sohbet dosyaları) --- OPSIYONEL
#
# Bu dort degisken tanimli degilse dosyalar backend/uploads altina yazilir ve
# sunucu onlari /uploads adresinden servis eder; yerelde gelistirmek icin bir
# AWS hesabina gerek yoktur. Uretimde S3 kullanin: yerel disk konteyner yeniden
# baslayinca kaybolur ve birden fazla ornek arasinda paylasilmaz.
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
AWS_REGION=eu-north-1
S3_BUCKET=support-io-bucket
# Eski dağıtımlar için yedek isim; S3_BUCKET tanımlıysa gerekmez
AWS_BUCKET_NAME=support-io-bucket
# Sadece ACL'leri AÇIK olan bir bucket kullanılıyorsa doldurun (ör. public-read).
# Bucket owner enforced modunda BOŞ bırakılmalı, aksi halde yükleme
# AccessControlListNotSupported hatası verir.
# S3_ACL=

# --- PostgreSQL (DATABASE_URL varsa DB_* değerlerinin önüne geçer) ---
DATABASE_URL=postgresql://support_user:<parola>@localhost:5432/support.io
DB_HOST=localhost
DB_PORT=5432
DB_NAME=support.io
DB_USER=support_user
DB_PASSWORD=<parola>
# Yönetilen veritabanları TLS ister, yerel sunucu genelde reddeder
DB_SSL=false

# --- CORS ---
# Tarayicidan API'ye istek atmasina izin verilen tam origin listesi (virgulle).
# Tanimli degilse mevcut dagitim adresi varsayilan olarak kalir.
# NODE_ENV=production DEGILSE localhost portlari ayrica otomatik eklenir.
# CORS_ORIGINS=https://panel.ornek.com,https://www.ornek.com

# --- Olceklendirme ---
# Socket.IO'yu birden fazla surece cikarmak icin gereklidir. Tanimsizsa backend
# tek surec modunda calisir (bugunku davranis).
# REDIS_URL=redis://127.0.0.1:6381

# SLA sayaclarini isleyen arka plan supurucusu. Cok surecli kurulumda yalnizca
# bir surecte acik birakin.
# SLA_SWEEPER=off
# SLA_SWEEP_INTERVAL_MS=60000

# PostgreSQL havuzu. Yuk altinda en kritik ayar.
# DB_POOL_MAX=20
# DB_POOL_MIN=0
# DB_CONNECTION_TIMEOUT_MS=10000
# DB_STATEMENT_TIMEOUT_MS=15000

# Hiz sinirlari (sayac surec basinadir).
# API_RATE_MAX=1000
# API_RATE_WINDOW_MS=900000
# AUTH_RATE_MAX=100
