# backend/.env örneği — gerçek değerleri .env dosyasına yazın (.env git'e girmez)

PORT=5000
NODE_ENV=development
JWT_SECRET=<rastgele-uzun-secret>

WIDGET_URL=http://localhost:3001
ADMIN_URL=http://localhost:3004

# --- AWS S3 (logo + sohbet dosyaları) ---
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
AWS_REGION=eu-north-1
S3_BUCKET=support-io-bucket
# Eski dağıtımlar için yedek isim; S3_BUCKET tanımlıysa gerekmez
AWS_BUCKET_NAME=support-io-bucket
# Sadece ACL'leri AÇIK olan bir bucket kullanılıyorsa doldurun (ör. public-read).
# Bucket owner enforced modunda BOŞ bırakılmalı, aksi halde yükleme
# AccessControlListNotSupported hatası verir.
# S3_ACL=

# --- PostgreSQL (DATABASE_URL varsa DB_* değerlerinin önüne geçer) ---
DATABASE_URL=postgresql://support_user:<parola>@localhost:5432/support.io
DB_HOST=localhost
DB_PORT=5432
DB_NAME=support.io
DB_USER=support_user
DB_PASSWORD=<parola>
# Yönetilen veritabanları TLS ister, yerel sunucu genelde reddeder
DB_SSL=false
