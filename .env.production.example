# Production settings for docker-compose.prod.yml (plan §13.5).
#
# Copy to /opt/supportio/.env.production on the server, fill in, then
#   chmod 600 .env.production
# It is never committed. The backend refuses to start while a required value
# is missing or still the example (backend/src/config/productionChecks.ts) and
# lists everything that is wrong at once.

# --- domain and image --------------------------------------------------------
APP_DOMAIN=app.example.com
# /.well-known/security.txt (SEC-10): a mailbox somebody reads. Empty means
# security@ on the panel's domain. SECURITY_TXT_EXPIRES (ISO date) pins the
# Expires line; empty keeps it 180 days ahead.
SECURITY_CONTACT_EMAIL=
SECURITY_TXT_EXPIRES=
# Set by scripts/deploy.sh; an exact tag, never latest.
APP_IMAGE=ghcr.io/uhutsancar/supportio:sha-0000000

# --- database ----------------------------------------------------------------
DB_NAME=supportchat
DB_USER=support_user
# PostgreSQL with WAL-G, from the release workflow's summary (DR-02).
POSTGRES_IMAGE=
DB_PASSWORD=replace-with-a-long-random-password
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=15000

# --- secrets -----------------------------------------------------------------
# At least 32 random characters: openssl rand -base64 48
# Session, widget and checkout signing keys are all derived from it.
JWT_SECRET=replace-with-at-least-32-random-characters
# Only while rotating JWT_SECRET (runbook §8, SEC-18): the old value. Empty
# otherwise.
JWT_SECRET_PREVIOUS=

# Redis asks for a password even on the Docker network (SEC-12). It goes into
# a URL, so letters and digits only: openssl rand -hex 24
REDIS_PASSWORD=replace-with-openssl-rand-hex-24

# Cloudflare Turnstile on the sign-up form (SEC-06): the site key is public,
# the secret is not. Empty: no bot check (the boot log warns).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- limits ------------------------------------------------------------------
REDIS_MAXMEMORY=256mb
# Container ceilings (docker-compose.prod.yml); starting values for a
# 2 vCPU / 4 GB server, to be adjusted after the staging load test.
BACKEND_MEM_LIMIT=1536m
BACKEND_CPUS=1.5
POSTGRES_MEM_LIMIT=1280m
REDIS_MEM_LIMIT=320m
CADDY_MEM_LIMIT=256m
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_MAX_CONNECTIONS=50
API_RATE_MAX=3000
AUTH_RATE_MAX=100
SHUTDOWN_GRACE_MS=10000

# --- e-mail (verification, password reset, invitations) ---------------------
MAIL_PROVIDER=smtp
MAIL_FROM="Support.io <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Staging only: the recipient domains mail may go to, comma-separated; mail
# to anyone else is withheld and logged (INF-03). Production: leave empty.
MAIL_ALLOWLIST_DOMAINS=

# --- file uploads: S3-compatible storage (decision A) ------------------------
# Amazon S3: AWS_REGION + S3_BUCKET. Cloudflare R2 / Hetzner: S3_ENDPOINT too,
# and S3_PUBLIC_URL for the public address logos are served from.
#
# Chat attachments are private (org/<org>/site/<site>/...): the bucket must
# NOT be public. Only the logos/ prefix is read publicly — give it a public
# read policy (R2: a public bucket domain limited to logos/, or a bucket
# policy on logos/*). Attachments open through links the API signs for 12 h,
# which answer with a 5-minute presigned address. Turn on bucket versioning
# and keep deleted versions 30 days (docs/disaster-recovery.md).
# ZIP and RAR are refused unless ALLOW_ARCHIVE_UPLOADS=true.
UPLOAD_STORAGE=s3
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_ACL=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- AI assistant ------------------------------------------------------------
# Google Gemini, free tier. Empty: the assistant stays off, live chat works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=10
GEMINI_RPD=900
# free (default) or paid: the Gemini API terms of the key's project. On free,
# visitors from the EEA, Switzerland and the UK are never sent to the model.
# Billing is the owner's decision (KARAR-AI-1); nothing here turns it on.
GEMINI_TIER=free
# Estimated cost of one answer (any currency), for org:list. Empty: not shown.
GEMINI_COST_PER_ANSWER=
# Emergency: true switches the assistant off everywhere. Without a restart:
# npm run assistant:kill:prod -- on
ASSISTANT_KILL_SWITCH=false

# --- Error tracking (OBS-01) ------------------------------------------------
# A Sentry-compatible DSN (Sentry EU region, or a self-hosted GlitchTip).
# Empty: nothing is sent; the log keeps everything. Only scrubbed error
# type, message and stack leave the server (docs/monitoring.md).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Share of widget error reports kept (0-1).
WIDGET_TELEMETRY_SAMPLE=0.1

# --- Monitoring (docs/monitoring.md) --------------------------------------
# scripts/watchdog.sh posts alerts here (Slack, Discord or Telegram URL).
ALERT_WEBHOOK_URL=
# Optional bearer token for /internal/metrics (Docker network only anyway).
METRICS_TOKEN=
# scripts/ship-logs.sh copies a day of logs here (rclone remote, private).
LOG_REMOTE=
# The weekly product report (org:stats) goes here, Monday morning UTC.
OPS_REPORT_EMAIL=

# --- Paddle billing ----------------------------------------------------------
# Keep BILLING_ENABLED=false until the sandbox acceptance tests pass. With
# true, the API key, webhook secret, client token and PRO price are required.
BILLING_ENABLED=false
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_PRO=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_PRICE_ENTERPRISE=
PADDLE_PRICE_ENTERPRISE_YEARLY=
BILLING_PAST_DUE_GRACE_DAYS=7

# --- staging (docs/production-runbook.md §10) --------------------------------
# true on staging: robots.txt disallows everything and every page says
# noindex (MKT-02). Production: false.
SITE_NOINDEX=false

# --- backups (scripts/backup-postgres.sh) ------------------------------------
# rclone remote for the off-site copy, e.g. r2:supportio-backups/postgres
BACKUP_REMOTE=
# age public key (age-keygen) the dump is encrypted for; keep the private key
# OFF this server.
BACKUP_AGE_RECIPIENT=
BACKUP_PING_URL=
# Weekly restore test of the night's dump (DR-03): weekly | always | off
BACKUP_VERIFY=weekly
BACKUP_VERIFY_PING_URL=

# --- point-in-time recovery: WAL-G (docs/disaster-recovery.md, DR-02) -------
# off until the bucket below exists; then on, and restart postgres.
PG_ARCHIVE_MODE=off
# Its own bucket (or prefix), e.g. s3://supportio-wal/prod — not the uploads one.
WALG_S3_PREFIX=
WALG_AWS_ACCESS_KEY_ID=
WALG_AWS_SECRET_ACCESS_KEY=
# R2: https://<account>.r2.cloudflarestorage.com ; AWS: empty
WALG_AWS_ENDPOINT=
WALG_AWS_REGION=auto
# 32 random bytes as hex (openssl rand -hex 32). Keep a copy OFF this server:
# without it the archive cannot be read.
WALG_LIBSODIUM_KEY=
