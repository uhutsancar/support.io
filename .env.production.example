APP_DOMAIN=support.example.com
DB_NAME=supportchat
DB_USER=support_user
DB_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=15000
REDIS_MAXMEMORY=512mb
API_RATE_MAX=3000
AUTH_RATE_MAX=100

# Optional: required only for logo and chat file uploads.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
S3_ACL=

# Self-hosted model (ai/README.md). Off by default; the inbox does not depend
# on it. Roll out in this order: AI_ENABLED=true with sites on copilot first,
# then AI_AUTO_REPLY_ENABLED=true and one pilot site on auto.
# COMPOSE_PROFILES=ai
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=
AI_AUTO_REPLY_ENABLED=false
