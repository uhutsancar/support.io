# Production settings for docker-compose.prod.yml (plan §13.5).
#
# Copy to /opt/supportio/.env.production on the server, fill in, then
#   chmod 600 .env.production
# It is never committed. The backend refuses to start while a required value
# is missing or still the example (backend/src/config/productionChecks.ts) and
# lists everything that is wrong at once.

# --- domain and image --------------------------------------------------------
APP_DOMAIN=app.example.com
# Set by scripts/deploy.sh; an exact tag, never latest.
APP_IMAGE=ghcr.io/uhutsancar/supportio:sha-0000000

# --- database ----------------------------------------------------------------
DB_NAME=supportchat
DB_USER=support_user
DB_PASSWORD=replace-with-a-long-random-password
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=15000

# --- secrets -----------------------------------------------------------------
# At least 32 random characters: openssl rand -base64 48
# Session, widget and checkout signing keys are all derived from it.
JWT_SECRET=replace-with-at-least-32-random-characters

# --- limits ------------------------------------------------------------------
REDIS_MAXMEMORY=256mb
API_RATE_MAX=3000
AUTH_RATE_MAX=100
SHUTDOWN_GRACE_MS=10000

# --- e-mail (verification, password reset, invitations) ---------------------
MAIL_PROVIDER=smtp
MAIL_FROM="Support.io <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- file uploads: S3-compatible storage (decision A) ------------------------
# Amazon S3: AWS_REGION + S3_BUCKET. Cloudflare R2 / Hetzner: S3_ENDPOINT too,
# and S3_PUBLIC_URL for the public address the files are served from.
UPLOAD_STORAGE=s3
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_ACL=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- AI assistant ------------------------------------------------------------
# Google Gemini, free tier. Empty: the assistant stays off, live chat works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=10
GEMINI_RPD=900

# --- Paddle billing ----------------------------------------------------------
# Keep BILLING_ENABLED=false until the sandbox acceptance tests pass. With
# true, the API key, webhook secret, client token and PRO price are required.
BILLING_ENABLED=false
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_PRO=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_PRICE_ENTERPRISE=
PADDLE_PRICE_ENTERPRISE_YEARLY=
BILLING_PAST_DUE_GRACE_DAYS=7

# --- backups (scripts/backup-postgres.sh) ------------------------------------
# rclone remote for the off-site copy, e.g. r2:supportio-backups/postgres
BACKUP_REMOTE=
# age public key (age-keygen) the dump is encrypted for; keep the private key
# OFF this server.
BACKUP_AGE_RECIPIENT=
BACKUP_PING_URL=
